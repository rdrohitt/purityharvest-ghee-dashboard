# API base URL (no trailing slash). Used for login and all /api/* requests.
# Production: https://purityharvest-production.up.railway.app
VITE_API_BASE_URL=

# MSG91 WhatsApp authkey. Optional — default lives in src/config/msg91.ts
# and is reused by all MSG91 WhatsApp calls.
VITE_MSG91_AUTHKEY=

# Shipping API (Shipmozo) keys for the orders table "Push" button.
# Put real values in .env.local (gitignored), not in committed .env files.
VITE_SHIPMOZO_PUBLIC_KEY=
VITE_SHIPMOZO_PRIVATE_KEY=
